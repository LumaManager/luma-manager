API_PORT=4000
WEB_ORIGIN=http://localhost:3000
APP_SESSION_SECRET=change-me-in-local-dev

# AUTH_PROVIDER=real  → usa banco de dados real
# AUTH_PROVIDER=mock  → bypassa banco, usa credenciais fixas abaixo
AUTH_PROVIDER=real

# Credenciais para AUTH_PROVIDER=mock (só para dev sem banco)
MOCK_THERAPIST_EMAIL=ana@institutovivace.com.br
MOCK_THERAPIST_PASSWORD=12345678
MOCK_MFA_CODE=123456

# MFA
# REQUIRE_MFA=false → login completa direto após email+senha (sem TOTP)
# REQUIRE_MFA=true  → fluxo completo de MFA (obrigatório em produção)
REQUIRE_MFA=false
# MFA_ENCRYPTION_KEY é opcional quando REQUIRE_MFA=false
# Quando REQUIRE_MFA=true, gere com: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# Banco de dados (Railway injeta automaticamente quando há serviço Postgres)
DATABASE_URL=

# Supabase (opcional — não usado no MVP)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Email transacional (Resend)
RESEND_API_KEY=

# Outros
DRIZZLE_LOG_SQL=false
BRAZIL_ONLY_PROCESSING=true
AUDIO_TRANSCRIPTION_ENABLED=false
