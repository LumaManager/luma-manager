#!/usr/bin/env bash
# git pre-commit hook — bloqueia commits com secrets/chaves sensíveis
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Padrões que indicam segredos — regex compatível com grep -E
SECRET_PATTERNS=(
  # Chaves de API reais (comprimento mínimo para evitar falso positivo)
  '[A-Za-z0-9_]{20,}[A-Za-z0-9]{10,}'   # strings longas genéricas (filtradas abaixo)
  'RESEND_API_KEY\s*=\s*re_[A-Za-z0-9_]+'
  'DATABASE_URL\s*=\s*postgres'
  'APP_SESSION_SECRET\s*=\s*[^\$][^{]'
  'SUPABASE_SERVICE_ROLE_KEY\s*='
  'SUPABASE_ANON_KEY\s*='
  'RAILWAY_TOKEN\s*='
  'VERCEL_TOKEN\s*='
  'previewModeSigningKey'
  'previewModeEncryptionKey'
  # Padrões de formato de chave conhecidos
  're_[A-Za-z0-9]{30,}'            # Resend API key
  'eyJ[A-Za-z0-9_-]{40,}\.'        # JWT token (não apenas prefixo)
  'sk-[A-Za-z0-9]{40,}'            # OpenAI/Anthropic keys
  'rw_[A-Za-z0-9]{30,}'            # Railway token
  'postgres://[^$].*@'             # Database URL com credenciais
  'postgresql://[^$].*@'
)

# Arquivos que nunca devem ser commitados
BLOCKED_FILES=(
  '.env'
  '.env.local'
  '.env.production'
  '.env.staging'
  '*.pem'
  '*.key'
  '.next.bak*'
)

FOUND=0

# ── 1. Verificar nomes de arquivos bloqueados ──────────────────────────────────
staged_files=$(git diff --cached --name-only)

for file in $staged_files; do
  for pattern in "${BLOCKED_FILES[@]}"; do
    if [[ "$file" == $pattern ]] || [[ "$(basename "$file")" == $pattern ]]; then
      echo -e "${RED}[BLOCKED]${NC} Arquivo sensível detectado: $file"
      FOUND=1
    fi
  done
done

# ── 2. Varrer conteúdo staged por padrões de segredo ──────────────────────────
# Ignorar arquivos de exemplo, binários, e o próprio hook
IGNORED_PATHS=('.example' 'CLAUDE.md' 'scripts/hooks/' '.gitignore' 'test-scheduling-flow.mjs' 'README' 'docs/superpowers/' 'drizzle/')

for file in $staged_files; do
  # Pular binários
  if git diff --cached --name-only -z | xargs -0 file | grep -q "binary"; then
    continue
  fi

  skip=0
  for ignore in "${IGNORED_PATHS[@]}"; do
    if [[ "$file" == *"$ignore"* ]]; then
      skip=1; break
    fi
  done
  [[ $skip -eq 1 ]] && continue

  content=$(git show ":$file" 2>/dev/null || true)

  for pattern in "${SECRET_PATTERNS[@]}"; do
    match=$(echo "$content" | grep -E "$pattern" | grep -v "process\.env\|env\.\|YOUR_\|your-\|xxx\|placeholder\|example\|TODO" | head -1 || true)
    if [[ -n "$match" ]]; then
      echo -e "${RED}[SECRET]${NC} Padrão suspeito em $file:"
      echo -e "  ${YELLOW}→${NC} $(echo "$match" | head -c 120)"
      FOUND=1
      break
    fi
  done
done

# ── 3. Resultado ───────────────────────────────────────────────────────────────
if [[ $FOUND -ne 0 ]]; then
  echo ""
  echo -e "${RED}╔══════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║  COMMIT BLOQUEADO — segredo ou arquivo sensível      ║${NC}"
  echo -e "${RED}║  Remova antes de commitar. Nunca commite secrets.    ║${NC}"
  echo -e "${RED}╚══════════════════════════════════════════════════════╝${NC}"
  exit 1
fi

exit 0
